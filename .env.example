DATABASE_URL="postgresql://user:password@localhost:5432/adonismob15th?schema=public"
# If using Supabase: use the Session pooler connection string (the one
# whose hostname contains "pooler"), not the direct connection (port 5432).
# Supabase's direct connection is IPv6-only, which most hosting platforms'
# build/runtime networks (e.g. Vercel) can't reach. This Prisma version
# doesn't support splitting a pooled-runtime URL from a direct-migrations
# one, so the pooler URL has to do both — it works for both here.

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Flutterwave (get from https://dashboard.flutterwave.com — use TEST keys for development)
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_ENCRYPTION_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
