DATABASE_URL="postgresql://user:password@localhost:5432/adonismob15th?schema=public"
# If using Supabase: use the DIRECT connection string (port 5432), not the
# pooled/pgbouncer one (port 6543). This Prisma version doesn't support
# splitting pooled-runtime from direct-migrations connections, so one URL
# has to do both — direct is the one that works for both.

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Flutterwave (get from https://dashboard.flutterwave.com — use TEST keys for development)
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_ENCRYPTION_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET_HASH=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
