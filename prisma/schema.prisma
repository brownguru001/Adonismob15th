// ADONISMOB15TH — core data model
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  MEMBER
  ADMIN
}

enum MembershipStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum DesignStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PRODUCTION
  READY
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  FLUTTERWAVE
}

enum CustomOrderStatus {
  SUBMITTED
  REVIEWING
  QUOTE_SENT
  CUSTOMER_APPROVED
  PAYMENT
  PRODUCTION
  READY
  FULFILLED
  DECLINED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum ProductionStage {
  QUEUED
  ASSIGNED
  PRINTING
  QUALITY_CHECK
  PACKED
  READY_FOR_DELIVERY
  SHIPPED
  DELIVERED
}

// ---------- Identity & membership ----------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role     @default(MEMBER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  membership    Membership?
  addresses     Address[]
  orders        Order[]
  customOrders  CustomOrder[]
  adminActions  AdminAction[]     @relation("AdminActionActor")
  invitationsSent Invitation[]    @relation("InvitationInviter")

  @@index([role])
}

model Membership {
  id             String           @id @default(cuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         MembershipStatus @default(PENDING)
  verifiedAt     DateTime?
  verifiedById   String?
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}

model Invitation {
  id          String           @id @default(cuid())
  email       String
  code        String           @unique @default(cuid())
  status      InvitationStatus @default(PENDING)
  invitedById String
  invitedBy   User             @relation("InvitationInviter", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@index([email])
  @@index([status])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  line1       String
  line2       String?
  city        String
  state       String
  country     String   @default("Nigeria")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  orders      Order[]

  @@index([userId])
}

// ---------- Catalog ----------

model Collection {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  coverImage  String?
  startDate   DateTime?
  endDate     DateTime?
  featured    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products    Product[]
  designs     Design[]

  @@index([featured])
}

model Design {
  id            String       @id @default(cuid())
  title         String
  description   String?
  imageUrl      String
  status        DesignStatus @default(DRAFT)
  collectionId  String?
  collection    Collection?  @relation(fields: [collectionId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  products      Product[]

  @@index([status])
}

model Product {
  id                    String     @id @default(cuid())
  name                  String
  slug                  String     @unique
  description           String
  category              String
  price                 Decimal    @db.Decimal(10, 2)
  cost                  Decimal    @db.Decimal(10, 2) @default(0)
  images                String[]
  careInfo              String?
  featured              Boolean    @default(false)
  isActive              Boolean    @default(true)
  // Pre-order / limited-drop foundation — deliberately minimal. Not every
  // product uses these; null means "not a pre-order" / "no drop cap".
  isPreOrder            Boolean    @default(false)
  preOrderClosesAt      DateTime?
  dropQuantityLimit     Int?
  dropQuantityRemaining Int?
  collectionId          String?
  collection            Collection? @relation(fields: [collectionId], references: [id])
  designId              String?
  design                Design?    @relation(fields: [designId], references: [id])
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  variants      ProductVariant[]
  orderItems    OrderItem[]

  @@index([category])
  @@index([featured])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size        String
  color       String
  sku         String   @unique
  stock       Int      @default(0)
  priceDelta  Decimal  @db.Decimal(10, 2) @default(0)
  createdAt   DateTime @default(now())

  orderItems  OrderItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

// ---------- Orders / payments ----------

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  addressId       String?
  address         Address?    @relation(fields: [addressId], references: [id])
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotal        Decimal     @db.Decimal(10, 2)
  shippingFee     Decimal     @db.Decimal(10, 2) @default(0)
  total           Decimal     @db.Decimal(10, 2)
  customerEmail   String
  customerPhone   String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
  payments        Payment[]
  productionOrder ProductionOrder?
  statusEvents    OrderStatusEvent[]

  @@index([userId])
  @@index([status])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String
  variant     ProductVariant  @relation(fields: [variantId], references: [id])
  quantity    Int
  unitPrice   Decimal         @db.Decimal(10, 2)
  lineTotal   Decimal         @db.Decimal(10, 2)

  @@index([orderId])
}

model Payment {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id])
  provider        PaymentProvider @default(FLUTTERWAVE)
  txRef           String          @unique
  providerRef     String?
  amount          Decimal         @db.Decimal(10, 2)
  status          PaymentStatus   @default(PENDING)
  verifiedAt      DateTime?
  rawResponse     Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([orderId])
  @@index([status])
}

// ---------- Custom orders ----------

model CustomOrder {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  productType     String
  quantity        Int
  sizes           String
  designNotes     String
  colorPreference String?
  referenceImages String[]
  status          CustomOrderStatus @default(SUBMITTED)
  quotedPrice     Decimal?          @db.Decimal(10, 2)
  adminNotes      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  statusEvents    CustomOrderStatusEvent[]

  @@index([userId])
  @@index([status])
}

model CustomOrderStatusEvent {
  id            String            @id @default(cuid())
  customOrderId String
  customOrder   CustomOrder       @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
  status        CustomOrderStatus
  note          String?
  createdAt     DateTime          @default(now())

  @@index([customOrderId])
}

// ---------- Production / suppliers ----------

model Supplier {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  location     String?
  services     String?
  pricingNotes String?
  capabilities String?
  status       SupplierStatus @default(ACTIVE)
  internalNotes String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  productionOrders ProductionOrder[]

  @@index([status])
}

model ProductionOrder {
  id          String          @id @default(cuid())
  orderId     String          @unique
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId  String?
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  stage       ProductionStage @default(QUEUED)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([supplierId])
  @@index([stage])
}

// ---------- Contact ----------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
}

// ---------- Audit ----------

model AdminAction {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AdminActionActor", fields: [actorId], references: [id])
  action    String
  targetType String
  targetId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
}
